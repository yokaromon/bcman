DATABASE_URL=sqlite:///./bcman.db
STORAGE_DIR=./storage
ROOT_PATH=/bcman
AI_BASE_URL=https://app.ykr.ltd/ai/v1
AI_API_KEY=dummy
AI_MODEL=Qwen/Qwen3-VL-8B-Instruct
MAX_UPLOAD_BYTES=20971520
# Recognition Pipeline V2（docs/adr/0019）。既定OFF。trueにしても適用されるのは
# 管理者が写真ごとに明示opt-inした新規写真だけで、既存の名刺は再処理しない。
# 有効化する前に app/recognition_v2/provision_models.py で向きモデルを配置すること。
RECOGNITION_PIPELINE_V2_ENABLED=false
